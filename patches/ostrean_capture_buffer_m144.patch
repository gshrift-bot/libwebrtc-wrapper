+// Ostrean: in an RDP session the minimal shared-mode capture buffer (~20 ms)
+// overflows whenever the capture thread is a little late, and the lost frames
+// are heard as clicks (prod 21.11.2026: 5-10% of the microphone lost while
+// another reader of the same device lost nothing). Ask for headroom instead;
+// the stream is still read on every event, so this adds no latency.
+// OSTREAN_WEBRTC_CAPTURE_BUFFER_MS overrides it (0 = the WebRTC default).
+static REFERENCE_TIME OstreanCaptureBufferDuration() {
+  char value[16] = {0};
+  const DWORD length = GetEnvironmentVariableA(
+      "OSTREAN_WEBRTC_CAPTURE_BUFFER_MS", value, sizeof(value));
+  int ms = 100;
+  if (length > 0 && length < sizeof(value)) {
+    ms = atoi(value);
+  }
+  if (ms < 0) {
+    ms = 0;
+  }
+  if (ms > 500) {
+    ms = 500;
+  }
+  return static_cast<REFERENCE_TIME>(ms) * 10000;
+}
+
